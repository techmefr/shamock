{
    "name": "shamock",
    "version": "0.0.1",
    "description": "Schema-driven mock/fallback engine — validate fixtures against any Standard Schema (Zod, Valibot, ArkType…), optional MirageJS server.",
    "type": "module",
    "license": "MIT",
    "author": "techmefr",
    "packageManager": "pnpm@11.9.0",
    "homepage": "https://github.com/techmefr/shamock#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/techmefr/shamock.git"
    },
    "keywords": [
        "mock",
        "fixture",
        "standard-schema",
        "miragejs",
        "offline",
        "fallback",
        "mocking",
        "mock-data",
        "schema-validation",
        "typescript",
        "testing",
        "zod",
        "valibot",
        "arktype"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "unbuild",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "dev": "unbuild --stub"
    },
    "peerDependencies": {
        "miragejs": "^0.1.47"
    },
    "peerDependenciesMeta": {
        "miragejs": {
            "optional": true
        }
    },
    "devDependencies": {
        "miragejs": "^0.1.47",
        "typescript": "^5.9.3",
        "unbuild": "^3.6.1",
        "vitest": "^5.0.5",
        "zod": "^3.24.0"
    }
}
